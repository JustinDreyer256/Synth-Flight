  entry.pendulums.forEach((p) => {
    const pivotY = p.pivotSide === 'top' ? PLAY_TOP : PLAY_BOTTOM;
    const chainLength = p.chainLengthFrac * playHeight;
    const amplitude = p.ampFrac * playHeight;
    gates.push({
      type: 'pendulum',
