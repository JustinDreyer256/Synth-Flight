  gates.push({
    type: 'lightning',
    x: x,
    span: entry.spanPx,
    thickness: entry.thicknessPx,
    y1: PLAY_TOP + entry.y1Frac * playHeight,
    y2: PLAY_TOP + entry.y2Frac * playHeight,
    jitter: jitter,
    spawnFrame: frame,
    passed: false
  });
  return entry.spacing;
}

