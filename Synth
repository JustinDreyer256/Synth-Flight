      chainLength: chainLength,
      amplitude: amplitude,
      freq: p.freq,
      phase: p.phase,
      r: p.radiusPx,
      passed: false
    });
  });
  return entry.spacing;
}

function livePendulumBobY(g) {
  const dir = g.pivotSide === 'top' ? 1 : -1;
  return g.pivotY + dir * (g.chainLength + g.amplitude * Math.sin((frame - zoneStartFrame) * g.freq + g.phase));
