<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Synth Flight</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Monoton&family=Orbitron:wght@500;700;900&display=swap" rel="stylesheet">
<style>
  :root {
    --neon-cyan: #0ff0fc;
    --neon-pink: #ff2079;
    --neon-yellow: #ffd23f;
    --neon-gold: #ffd700;
  }
  html, body {
    margin: 0;
    padding: 0;
    height: 100%;
    background: #0d0221;
    overflow: hidden;
    touch-action: manipulation;
    font-family: 'Courier New', monospace;
  }
  #game-container {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    width: 100vw;
  }
  canvas {
    display: block;
    background: #0d0221;
  }
  #overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    pointer-events: none;
    color: #0ff0fc;
    text-shadow: 0 0 10px rgba(15,240,252,0.8), 0 0 22px rgba(255,32,121,0.4);
  }
  .menu-panel {
    background: rgba(13,2,33,0.85);
    border: 1px solid #0ff0fc;
    box-shadow: 0 0 18px rgba(15,240,252,0.5), inset 0 0 20px rgba(15,240,252,0.12);
    border-radius: 8px;
    padding: 28px 40px 34px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: auto;
  }
  #title {
    font-size: 32px;
    font-weight: bold;
    letter-spacing: 4px;
  }
  .game-logo {
    font-family: 'Monoton', cursive;
    font-weight: normal;
    letter-spacing: 6px;
    display: inline-block;
    transform: skewX(-8deg);
    background: linear-gradient(180deg, #ffffff 0%, #0ff0fc 45%, #b48aff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter:
      drop-shadow(0 3px 0 #1a0a2e)
      drop-shadow(0 0 18px rgba(255, 32, 121, 0.65))
      drop-shadow(0 0 36px rgba(15, 240, 252, 0.35));
  }
  .game-logo-plate {
    background: rgba(8, 3, 18, 0.55);
    border-radius: 10px;
    padding: 10px 28px;
    display: inline-block;
  }
  #subtitle {
    font-size: 15px;
    margin-top: 18px;
    line-height: 1.8;
    letter-spacing: 1px;
    text-align: center;
    color: #ff2079;
    text-shadow: 0 0 8px rgba(255,32,121,0.7);
  }
  #options-menu {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 34px;
    pointer-events: auto;
    min-width: 380px;
  }
  .options-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 22px;
    font-family: 'Courier New', monospace;
    font-size: 18px;
    font-weight: bold;
    letter-spacing: 2px;
    color: #0ff0fc;
    text-shadow: 0 0 8px rgba(15,240,252,0.6);
  }
  .options-row-label {
    cursor: default;
  }
  .options-row.clickable {
    cursor: pointer;
    border-radius: 3px;
    transition: background 0.12s ease;
  }
  .options-row.clickable:hover {
    background: rgba(15,240,252,0.1);
  }
  .options-row-value {
    display: flex;
    align-items: center;
    gap: 14px;
    user-select: none;
  }
  .options-arrow {
    cursor: pointer;
    display: inline-block;
    padding: 14px 16px;
    margin: -14px -4px;
    font-size: 22px;
    line-height: 1;
    color: #0ff0fc;
    transition: transform 0.1s ease, opacity 0.1s ease;
  }
  .options-arrow:hover {
    transform: scale(1.3);
  }
  .options-arrow.disabled {
    opacity: 0.2;
    cursor: default;
  }
  .options-arrow.disabled:hover {
    transform: none;
  }
  .options-difficulty-value {
    min-width: 130px;
    text-align: center;
  }
  .options-difficulty-value.difficulty-easy, .stepper-value.difficulty-easy, .settings-diff-name.difficulty-easy { color: #0ff0fc; text-shadow: 0 0 10px rgba(15,240,252,0.8); }
  .options-difficulty-value.difficulty-normal, .stepper-value.difficulty-normal, .settings-diff-name.difficulty-normal { color: #ffd23f; text-shadow: 0 0 10px rgba(255,210,63,0.8); }
  .options-difficulty-value.difficulty-hard, .stepper-value.difficulty-hard, .settings-diff-name.difficulty-hard { color: #ff2079; text-shadow: 0 0 10px rgba(255,32,121,0.8); }
  .options-difficulty-value.difficulty-extra, .stepper-value.difficulty-extra, .settings-diff-card.difficulty-extra:not(.locked) .settings-diff-name { color: #ff0000; text-shadow: 0 0 10px rgba(255,0,0,0.9); }

  /* Options panel v2 (uploaded design) */
  .options-panel-v2 {
    background: rgba(10, 2, 26, 0.92);
    border: 2px solid var(--neon-cyan);
    box-shadow: 0 0 20px rgba(0, 240, 255, 0.4), inset 0 0 15px rgba(0, 240, 255, 0.1);
    border-radius: 8px;
    padding: 24px;
    width: 460px;
    max-width: 90vw;
    box-sizing: border-box;
    pointer-events: auto;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .panel-header {
    text-align: center;
    font-size: 20px;
    letter-spacing: 4px;
    color: #fff;
    text-shadow: 0 0 8px var(--neon-cyan);
    margin-bottom: 20px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(0, 240, 255, 0.25);
  }
  .menu-stack {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 300px;
  }
  .menu-btn-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 44px;
    flex-shrink: 0;
    padding: 0 16px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(0, 240, 255, 0.2);
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s ease-in-out;
  }
  .menu-btn-row:hover {
    background: rgba(255, 0, 127, 0.15);
    border-color: var(--neon-pink);
    box-shadow: 0 0 12px rgba(255, 0, 127, 0.5);
    transform: translateX(4px);
  }
  .menu-btn-row.danger-row {
    border-color: rgba(255, 60, 60, 0.35);
  }
  .menu-btn-row.danger-row .menu-btn-label,
  .menu-btn-row.danger-row .row-action-indicator {
    color: #ff5c5c;
  }
  .menu-btn-row.danger-row:hover {
    background: rgba(255, 40, 40, 0.15);
    border-color: #ff3c3c;
    box-shadow: 0 0 12px rgba(255, 40, 40, 0.6);
  }
  .menu-btn-label {
    font-size: 13px;
    letter-spacing: 2px;
    color: #ffffff;
  }
  .stepper-control {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .stepper-arrow {
    background: rgba(0, 240, 255, 0.1);
    border: 1px solid var(--neon-cyan);
    color: var(--neon-cyan);
    width: 28px;
    height: 28px;
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.1s;
    font-family: inherit;
    padding: 0;
  }
  .stepper-arrow:hover {
    background: var(--neon-cyan);
    color: #000;
    box-shadow: 0 0 8px var(--neon-cyan);
  }
  .stepper-value {
    min-width: 90px;
    text-align: center;
    font-size: 13px;
    font-weight: 700;
    color: var(--neon-yellow);
    text-shadow: 0 0 6px rgba(255, 230, 0, 0.6);
  }
  .row-action-indicator {
    font-size: 11px;
    color: var(--neon-cyan);
    letter-spacing: 1px;
    opacity: 0.7;
  }
  .menu-btn-row:hover .row-action-indicator {
    opacity: 1;
    color: #fff;
    text-shadow: 0 0 6px var(--neon-pink);
  }
  .start-action-container {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px dashed rgba(255, 255, 255, 0.15);
  }
  .btn-start-game {
    width: 100%;
    height: 46px;
    background: linear-gradient(90deg, #ff007f 0%, #00f0ff 100%);
    border: none;
    border-radius: 4px;
    color: #ffffff;
    font-family: inherit;
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 3px;
    cursor: pointer;
    box-shadow: 0 0 16px rgba(255, 0, 127, 0.4);
    transition: filter 0.2s, box-shadow 0.2s;
  }
  .btn-start-game:hover {
    filter: brightness(1.2);
    box-shadow: 0 0 24px rgba(0, 240, 255, 0.8);
  }
  .confirm-panel {
    width: 420px;
    border-color: rgba(255, 60, 60, 0.6);
    box-shadow: 0 0 20px rgba(255, 40, 40, 0.35), inset 0 0 15px rgba(255, 40, 40, 0.08);
  }
  .confirm-danger-header {
    color: #ff5c5c;
  }
  .confirm-warning-text {
    margin-top: 18px;
    font-size: 13px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: 0.5px;
  }
  .confirm-warning-text strong {
    color: #ff5c5c;
  }
  .confirm-btn-row {
    display: flex;
    gap: 12px;
    margin-top: 26px;
  }
  .btn-confirm-cancel {
    flex: 1.3;
    height: 44px;
    background: rgba(15, 240, 252, 0.1);
    border: 1px solid var(--neon-cyan);
    border-radius: 4px;
    color: var(--neon-cyan);
    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 2px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .btn-confirm-cancel:hover {
    background: rgba(15, 240, 252, 0.2);
    box-shadow: 0 0 14px rgba(15, 240, 252, 0.5);
  }
  .btn-confirm-danger {
    flex: 1;
    height: 44px;
    background: rgba(255, 40, 40, 0.08);
    border: 1px solid rgba(255, 60, 60, 0.5);
    border-radius: 4px;
    color: #ff5c5c;
    font-family: inherit;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .btn-confirm-danger:hover {
    background: rgba(255, 40, 40, 0.2);
    border-color: #ff3c3c;
    box-shadow: 0 0 14px rgba(255, 40, 40, 0.5);
  }
  .settings-diff-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 22px;
    max-height: 60vh;
    overflow-y: auto;
    padding-right: 4px;
  }
  .settings-diff-card {
    border: 1px solid rgba(15,240,252,0.3);
    border-radius: 6px;
    padding: 12px 16px;
    background: rgba(255,255,255,0.03);
    text-align: left;
  }
  .settings-diff-name {
    font-size: 15px;
    font-weight: bold;
    letter-spacing: 2px;
    margin-bottom: 6px;
  }
  .settings-diff-stats {
    font-size: 12px;
    line-height: 1.7;
    color: #cdb8e8;
    letter-spacing: 0.5px;
  }
  .settings-diff-card.locked {
    opacity: 0.55;
    border-style: dashed;
  }
  .settings-diff-card.locked .settings-diff-name {
    color: #888;
  }
  .settings-diff-card.locked .settings-diff-stats {
    color: #888;
    font-style: italic;
  }
  .menu-btn-row.locked {
    opacity: 0.5;
    cursor: default;
    border-style: dashed;
  }
  .menu-btn-row.locked:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(0, 240, 255, 0.2);
    box-shadow: none;
    transform: none;
  }
  .menu-btn-row.locked .row-action-indicator {
    opacity: 0.7;
  }
  .zone-tile.achievement-tile {
    cursor: default;
  }
  .zone-tile.achievement-tile:hover {
    border-color: rgba(15, 240, 252, 0.25);
    background: rgba(255, 255, 255, 0.03);
    box-shadow: none;
    transform: none;
  }
  .zone-tile.achievement-done {
    opacity: 1;
    border-style: solid;
    border-color: rgba(80, 230, 140, 0.5);
    background: rgba(80, 230, 140, 0.08);
  }
  .zone-tile.achievement-done .tile-name {
    color: #baffd6;
  }
  .zone-tile.achievement-deathless {
    opacity: 1;
    border-style: solid;
    border-color: rgba(255, 214, 63, 0.5);
    background: rgba(255, 214, 63, 0.08);
  }
  .zone-tile.achievement-deathless .tile-name {
    color: #ffe9a8;
  }
  .zone-tile.achievement-deathless .tile-status {
    font-size: 13px;
    display: inline-block;
    transform: scaleX(1.15);
  }
  .zone-tile.achievement-distance {
    opacity: 1;
    border-style: solid;
    border-color: rgba(180, 130, 255, 0.5);
    background: rgba(180, 130, 255, 0.08);
  }
  .zone-tile.achievement-distance .tile-name {
    color: #d9c4ff;
  }
  .zone-tile.achievement-rank {
    opacity: 1;
    border-style: solid;
    border-color: rgba(255, 215, 0, 0.5);
    background: rgba(255, 215, 0, 0.08);
  }
  .zone-tile.achievement-rank .tile-name {
    color: #ffe9a0;
  }
  .achievement-section-header {
    margin: 20px 0 4px;
    padding-bottom: 6px;
    font-size: 11px;
    letter-spacing: 2px;
    color: rgba(255, 214, 63, 0.85);
    border-bottom: 1px solid rgba(255, 214, 63, 0.25);
  }
  .zone-select-panel {
    width: 780px;
    max-width: 92vw;
    max-height: 90vh;
    overflow-y: auto;
    box-sizing: border-box;
  }
  .zone-select-subtitle {
    text-align: center;
    font-size: 10px;
    color: var(--neon-pink);
    letter-spacing: 1.5px;
    margin-top: 4px;
    text-shadow: 0 0 6px rgba(255,32,121,0.5);
  }
  .zone-select-wrapper {
    display: flex;
    gap: 20px;
    width: 100%;
    margin-top: 18px;
  }
  .zone-grid {
    flex: 1.3;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
  }
  .menu-panel > .zone-grid {
    align-self: stretch;
  }
  .zone-tile {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(15,240,252,0.25);
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 8px;
    cursor: pointer;
    position: relative;
    transition: all 0.2s ease;
    min-height: 64px;
    min-width: 0;
  }
  .zone-tile:hover {
    border-color: var(--neon-pink);
    background: rgba(255,32,121,0.15);
    box-shadow: 0 0 6px rgba(255,32,121,0.5);
    transform: translateY(-2px);
  }
  .zone-tile.active {
    border-color: var(--neon-cyan);
    background: rgba(15,240,252,0.15);
    box-shadow: 0 0 6px rgba(15,240,252,0.6);
  }
  .zone-tile.locked {
    border-color: rgba(255,255,255,0.08);
    background: rgba(0,0,0,0.3);
    opacity: 0.5;
    cursor: default;
  }
  .zone-tile.locked:hover {
    border-color: rgba(255,255,255,0.08);
    background: rgba(0,0,0,0.3);
    box-shadow: none;
    transform: none;
  }
  .tile-num {
    font-size: 10px;
    color: var(--neon-cyan);
    font-weight: 700;
  }
  .tile-name {
    font-size: 8px;
    color: #fff;
    letter-spacing: 0.5px;
    margin-top: 4px;
    line-height: 1.2;
    overflow-wrap: break-word;
    hyphens: auto;
  }
  .tile-status {
    align-self: flex-end;
    font-size: 12px;
  }
  .zone-preview-panel {
    flex: 0.9;
    background: rgba(10,2,26,0.6);
    border: 1px solid var(--neon-cyan);
    box-shadow: 0 0 20px rgba(15,240,252,0.3);
    border-radius: 8px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    pointer-events: auto;
  }
  .preview-viewport {
    width: 100%;
    height: 130px;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 4px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .preview-details {
    margin-top: 12px;
  }
  .preview-title {
    font-size: 15px;
    color: var(--neon-yellow);
    letter-spacing: 2px;
    margin-bottom: 6px;
  }
  .preview-stats {
    font-size: 10px;
    color: rgba(255,255,255,0.7);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .btn-warp {
    width: 100%;
    height: 42px;
    background: linear-gradient(90deg, #ff2079 0%, #0ff0fc 100%);
    border: none;
    border-radius: 4px;
    color: #fff;
    font-family: inherit;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 2px;
    cursor: pointer;
    box-shadow: 0 0 12px rgba(255,32,121,0.4);
    margin-top: 10px;
    pointer-events: auto;
  }
  .btn-warp:hover {
    filter: brightness(1.2);
    box-shadow: 0 0 20px rgba(15,240,252,0.8);
  }
  .btn-warp:disabled {
    opacity: 0.4;
    cursor: default;
    filter: none;
    box-shadow: none;
  }
  .panel-footer-hint {
    margin-top: 16px;
    text-align: center;
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--neon-pink);
    text-shadow: 0 0 6px rgba(255,32,121,0.4);
  }
  .scrollable-overlay-list {
    scrollbar-width: thin;
    scrollbar-color: var(--neon-cyan) rgba(0,0,0,0.35);
  }
  .scrollable-overlay-list::-webkit-scrollbar {
    width: 8px;
  }
  .scrollable-overlay-list::-webkit-scrollbar-track {
    background: rgba(0,0,0,0.35);
    border-radius: 4px;
    border: 1px solid rgba(0,240,255,0.15);
  }
  .scrollable-overlay-list::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, var(--neon-cyan) 0%, var(--neon-pink) 100%);
    border-radius: 4px;
    box-shadow: 0 0 6px rgba(15,240,252,0.7);
  }
  .scrollable-overlay-list::-webkit-scrollbar-thumb:hover {
    box-shadow: 0 0 10px rgba(255,32,121,0.9);
  }
  #menu-start-prompt {
    margin-top: 30px;
    font-size: 28px;
    font-weight: bold;
    letter-spacing: 3px;
    color: var(--neon-pink);
    text-shadow: 0 0 10px rgba(255,32,121,0.9), 0 0 24px rgba(255,32,121,0.5);
    animation: startPromptBlink 1.4s ease-in-out infinite;
    cursor: pointer;
    pointer-events: auto;
  }
  @keyframes startPromptBlink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.2; }
  }
  #sub-panel-back {
    margin-top: 30px;
    font-size: 16px;
    letter-spacing: 2px;
    color: #ff2079;
    text-shadow: 0 0 8px rgba(255,32,121,0.7);
    cursor: pointer;
    pointer-events: auto;
  }
  #sub-panel-back:hover {
    text-shadow: 0 0 14px rgba(255,32,121,0.9);
  }
  .reward-card {
    width: 580px;
    max-width: 90vw;
    box-sizing: border-box;
    margin-top: 18px;
    background: rgba(12, 3, 28, 0.94);
    border: 2px solid var(--neon-gold);
    box-shadow: 0 0 30px rgba(255, 215, 0, 0.3), inset 0 0 20px rgba(255, 215, 0, 0.1);
    border-radius: 10px;
    padding: 24px 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .rank-badge {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 215, 0, 0.1);
    border: 1px solid var(--neon-gold);
    padding: 8px 20px;
    border-radius: 20px;
    box-shadow: 0 0 15px rgba(255, 215, 0, 0.4);
    margin-bottom: 18px;
  }
  .rank-badge .star {
    color: var(--neon-gold);
    font-size: 16px;
  }
  .rank-badge .rank-text {
    font-family: 'Orbitron', sans-serif;
    font-size: 13px;
    font-weight: 900;
    color: var(--neon-gold);
    letter-spacing: 3px;
    text-shadow: 0 0 10px var(--neon-gold);
  }
  .stats-matrix {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    width: 100%;
    margin-bottom: 20px;
  }
  .stat-box {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(15, 240, 252, 0.2);
    border-radius: 6px;
    padding: 10px;
    text-align: center;
  }
  .stat-label {
    font-family: 'Orbitron', sans-serif;
    font-size: 9px;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 1px;
    margin-bottom: 4px;
  }
  .stat-value {
    font-family: 'Orbitron', sans-serif;
    font-size: 18px;
    font-weight: 900;
    color: var(--neon-cyan);
    text-shadow: 0 0 8px var(--neon-cyan);
  }
  .zone-breakdown-grid {
